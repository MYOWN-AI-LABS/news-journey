node_modules/
# a node_modules SYMLINK (worktree convenience) is a FILE, so "node_modules/" alone does not
# ignore it — one was committed and pushed on 2026-09-06 pointing at a local absolute path.
node_modules
.env
.env.*
!.env.example
*.bak
*.bak-*
.auth/
.playwright-mcp/
**/Cookies
**/Local State
**/*storageState*
workdir/
/state/
local-av/
logs/
graphify-out/
site/public/
# Generated by `npm run dash:observability` — reflects this machine's local workdir/videos state,
# so a committed copy would be stale the moment it lands.
docs/observability-dashboard.html
.vercel/
*.mp4
*.wav
*.m4a
*.audio-review.json
*.sqlite*
*.db
tts/.venv/
.DS_Store
__pycache__/
*.pyc

# Worktrees created for isolated agent/dev work. Never part of the release tree —
# committing one adds a gitlink that breaks a fresh clone.
.claude/worktrees/

# Workspace credentials and runtime artifacts are always private.
workspaces/

# Executive input documents and locally bootstrapped tooling never enter a release.
/profile/
/.tools/

# A workspace/member-specific local MCP connection, never a release asset.
/.vscode/mcp.json

# Public product guide, intentionally shipped; private publication media stays ignored.
!/docs/journey-assets/walkthrough-v6.mp4
!/docs/journey-assets/walkthrough-v8.mp4

!/docs/journey-assets/sample-slides.mp4
!/docs/journey-assets/sample-avatar.mp4
!/docs/journey-assets/sample-hybrid.mp4
# Sanitized example editions ship with their rendered videos.
!/examples/runs/*/video.mp4
/config/personalization.json
/assets/logo-*
# Personal publication runtime data must never enter release source.
/config/personal-profile.json
/PERSONAL_PROFILE.md
