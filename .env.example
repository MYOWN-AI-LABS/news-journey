# Optional GitHub API token for higher public-search rate limits. No repository scope is required.
GITHUB_TOKEN=

# Content model overrides. Keep provider keys only in this ignored .env file.
AI_CONTENT_MODEL_PROVIDER=
AI_CONTENT_MODEL_NAME=
AI_CONTENT_MODEL_BASE_URL=
AI_CONTENT_MODEL_API_KEY=
AI_CONTENT_MODEL_TIMEOUT_SECONDS=
ZAI_API_KEY=
XAI_API_KEY=
GEMINI_API_KEY=
OPENAI_COMPATIBLE_API_KEY=

# Google / YouTube OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# LinkedIn OAuth
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Meta / Instagram OAuth
META_APP_ID=
META_APP_SECRET=
IG_USER_ID=

# Threads OAuth
THREADS_APP_ID=
THREADS_APP_SECRET=

# X OAuth
X_CLIENT_ID=
X_CLIENT_SECRET=

# TikTok OAuth. Posting privacy defaults to SELF_ONLY.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
TIKTOK_PRIVACY=SELF_ONLY

# Reddit API identification
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_SUBREDDIT=test
REDDIT_USER_AGENT=

# Optional public media URL, used only when no LinkedIn video receipt exists.
# Example: https://cdn.example.com/videos/{id}.mp4
PUBLIC_VIDEO_URL_TEMPLATE=

# Browser profiles live outside the repository.
AI_CONTENT_BROWSER_PROFILE_DIR=
AI_CONTENT_X_BROWSER_PROFILE_DIR=
AI_CONTENT_NEWSLETTER_BROWSER_PROFILE_DIR=

# Optional archive-site links
NEWSLETTER_URL=
YOUTUBE_URL=
YOUTUBE_PRIVACY_STATUS=private
SUBSCRIBE_ENDPOINT=

# Optional voice and avatar providers. Local Kokoro/cards mode is the default.
ELEVENLABS_API_KEY=
HEYGEN_API_KEY=
FAL_KEY=
HEDRA_API_KEY=
RESEMBLE_API_KEY=
RESEMBLE_VOICE_UUID=
HEYGEM_BASE_URL=

# Optional conversational voice, separate from publication/narration models.
OPENAI_REALTIME_API_KEY=
