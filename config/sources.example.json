{
  "enabledSources": [
    "hn",
    "githubTrending",
    "rss"
  ],
  "editorial": {
    "preferredTopics": [
      "developer tools",
      "reliable automation",
      "open source software"
    ],
    "excludedTopics": [],
    "selectionNotes": "Favor verifiable releases and practical engineering impact. Prefer primary sources.",
    "areas": {
      "mission": "Find and explain the latest verifiable tools, research, and releases in the configured focus areas, and say who they affect.",
      "focusAreas": [
        "developer-tooling",
        "automation",
        "open-source",
        "other"
      ],
      "verticals": [
        "software-engineering",
        "data-and-analytics",
        "operations",
        "cross-industry",
        "other"
      ]
    }
  },
  "hn": {
    "queries": [
      "developer tools",
      "automation",
      "open source"
    ],
    "minPoints": 50,
    "windowHours": 48
  },
  "githubTrending": {
    "since": [
      "daily",
      "weekly"
    ],
    "languages": [
      "typescript",
      "python"
    ],
    "relevanceKeywords": [
      "developer tools",
      "automation",
      "workflow",
      "open source"
    ],
    "searchFallback": {
      "minStars": 200,
      "createdWithinDays": 14,
      "topics": [
        "developer-tools"
      ]
    }
  },
  "rss": [],
  "publicApis": {
    "catalog": {
      "categories": [
        "News",
        "Science & Math"
      ],
      "query": "",
